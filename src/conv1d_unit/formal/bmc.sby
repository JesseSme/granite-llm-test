# BMC of conv1d_unit stream-protocol invariants (fp_unit blackboxed).
# Run: sby -f bmc.sby

[tasks]
bmc

[options]
mode bmc
depth 120
expect pass

[engines]
smtbmc

[script]
read_verilog -sv fp_pkg.sv
read_verilog -sv fp_unit_stub.sv
read_verilog -sv conv1d_unit.sv
read_verilog -formal -sv conv1d_props.sv
prep -top conv1d_props

[files]
../../../systemverilog_fp_unit/rtl/fp_pkg.sv
fp_unit_stub.sv
../conv1d_unit.sv
conv1d_props.sv
