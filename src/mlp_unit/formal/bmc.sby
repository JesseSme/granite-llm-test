# BMC of mlp_unit AXI-Stream framing invariants
# (FP datapaths abstracted: matrix_unit stub + constant fp_unit/fp_exp_seq).
# Small instance: HIDDEN=8, INTER=4.
# Run: sby -f bmc.sby

[tasks]
bmc

[options]
mode bmc
depth 260
timeout 600
expect pass

[engines]
smtbmc boolector

[script]
read_verilog -sv fp_pkg.sv
read_verilog -sv fp_unit_stub.sv
read_verilog -sv fp_exp_seq_stub.sv
read_verilog -sv matrix_unit_stub.sv
read_verilog -sv fp32_to_bf16_round.sv
read_verilog -sv swiglu_unit.sv
read_verilog -sv mlp_unit.sv
read_verilog -formal -sv mlp_props.sv
prep -top mlp_props

[files]
../../../systemverilog_fp_unit/rtl/fp_pkg.sv
fp_unit_stub.sv
fp_exp_seq_stub.sv
matrix_unit_stub.sv
../../../systemverilog_fp_unit/rtl/fp32_to_bf16_round.sv
../SwiGLU_unit/swiglu_unit.sv
../mlp_unit.sv
mlp_props.sv
