# BMC of matrix_unit AXI-Stream/FSM invariants with LANES=4 (masked tail),
# fp_units abstracted. Run: sby -f bmc_lanes.sby

[tasks]
bmc_lanes

[options]
mode bmc
depth 40
expect pass

[engines]
smtbmc

[script]
read_verilog -sv fp_pkg.sv
read_verilog -sv fp_unit_stub.sv
read_verilog -sv fp_add_pipe2_stub.sv
read_verilog -sv fp32_to_bf16_round.sv
read_verilog -sv matrix_unit.sv
read_verilog -formal -sv matrix_props.sv
chparam -set LANES 4 matrix_props
prep -top matrix_props

[files]
../../../systemverilog_fp_unit/rtl/fp_pkg.sv
fp_unit_stub.sv
fp_add_pipe2_stub.sv
../../../systemverilog_fp_unit/rtl/fp32_to_bf16_round.sv
../matrix_unit.sv
matrix_props.sv
