# BMC of rmsnorm_unit control-path invariants (fp_unit blackboxed).
# Run: sby -f bmc.sby

[tasks]
bmc

[options]
mode bmc
depth 80
expect pass

[engines]
smtbmc

[script]
read_verilog -sv fp_pkg.sv
read_verilog -sv fp_unit_stub.sv
read_verilog -sv rmsnorm_unit.sv
read_verilog -formal -sv rmsnorm_props.sv
prep -top rmsnorm_props

[files]
../../../systemverilog_fp_unit/rtl/fp_pkg.sv
fp_unit_stub.sv
../rmsnorm_unit.sv
rmsnorm_props.sv
